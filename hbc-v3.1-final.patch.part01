+
+    private void restoreThermalState() {
+        restoreNode(siopEnablePath, baselineSiopEnable);
+        restoreNode(powerReducePath, baselinePowerReduce);
+        restoreNode(temperaturePath, baselineTemperature);
+        restoreNode(batterySiopPath, baselineBatterySiop);
+        thermalBypassActive = false;
+    }
+
+    private void restoreSystemState() {
+        if (autoBrightnessOverrideActive) releaseScaledAutoBrightness();
+        if (appForcedHbm) releaseHbmOnce();
+        restoreThermalState();
+        if (autoBrightnessPath.length() > 0 && baselineAuto.length() > 0) restoreNode(autoBrightnessPath, baselineAuto);
+        if (explicitHbmPath.length() > 0 && baselineExplicit.length() > 0) restoreNode(explicitHbmPath, baselineExplicit);
+        if (mdnieOutdoorPath.length() > 0) writeNode(mdnieOutdoorPath, "0");
+    }
+
+    private void restoreNode(String path, String value) {
+        if (path != null && path.length() > 0 && value != null && value.length() > 0) writeNode(path, value);
+    }
+
+    private String readText(String path) {
+        if (path == null || path.length() == 0) return "";
+        RootShell.Result r = RootShell.run("cat " + RootShell.sq(path));
+        return r.ok() ? r.out.trim() : "";
+    }
+
+    private void startForceStopWatcher() {
+        int pid = Process.myPid();
+        watchTokenPath = "/data/local/tmp/hbc_watch_" + pid + "_" + System.nanoTime();
+        RootShell.run("echo 1 > " + RootShell.sq(watchTokenPath));
+        StringBuilder restore = new StringBuilder();
+        appendRestore(restore, autoBrightnessPath, baselineAuto);
+        appendRestore(restore, explicitHbmPath, baselineExplicit);
+        if (mdnieOutdoorPath.length() > 0) appendRestore(restore, mdnieOutdoorPath, "0");
+        appendRestore(restore, siopEnablePath, baselineSiopEnable);
+        appendRestore(restore, powerReducePath, baselinePowerReduce);
+        appendRestore(restore, temperaturePath, baselineTemperature);
+        appendRestore(restore, batterySiopPath, baselineBatterySiop);
+        String proc = "/proc/" + pid + "/cmdline";
+        String script = "while [ -e " + RootShell.sq(watchTokenPath) + " ] && [ -r " + RootShell.sq(proc)
+                + " ] && cat " + RootShell.sq(proc) + " | tr '\\000' ' ' | grep -q "
+                + RootShell.sq(getPackageName()) + "; do sleep 1; done; " + restore
+                + "rm -f " + RootShell.sq(watchTokenPath) + ";";
+        RootShell.run("sh -c " + RootShell.sq("(" + script + ") >/dev/null 2>&1 </dev/null &"));
+    }
+
+    private void stopForceStopWatcher() {
+        if (watchTokenPath != null && watchTokenPath.length() > 0) {
+            RootShell.run("rm -f " + RootShell.sq(watchTokenPath));
+            watchTokenPath = "";
+        }
