+    private void applyScaledAutoBrightness(float effectiveLux) {
+        if (brightnessPath.length() == 0 || effectiveLux < 0f) return;
+        int target = samsungBrightnessForLux(effectiveLux);
+        int current = readInt(brightnessPath, -1);
+        if (current != target) writeNode(brightnessPath, Integer.toString(target));
+        autoBrightnessOverrideActive = true;
+    }
+
+    private void releaseScaledAutoBrightness() {
+        boolean androidAuto = false;
+        try {
+            androidAuto = Settings.System.getInt(getContentResolver(), Settings.System.SCREEN_BRIGHTNESS_MODE)
+                    == Settings.System.SCREEN_BRIGHTNESS_MODE_AUTOMATIC;
+        } catch (Throwable ignored) {}
+        if (androidAuto && brightnessPath.length() > 0 && filteredLux >= 0f) {
+            writeNode(brightnessPath, Integer.toString(samsungBrightnessForLux(filteredLux)));
+        }
+        autoBrightnessOverrideActive = false;
+    }
+
+    private int samsungBrightnessForLux(float lux) {
+        final float[] x = {0f, 6f, 50f, 500f, 1000f, 4999f, 5000f};
+        final int[] y = {30, 30, 59, 134, 161, 219, 255};
+        if (lux <= x[0]) return y[0];
+        for (int i = 1; i < x.length; i++) {
+            if (lux <= x[i]) {
+                float f = (lux - x[i - 1]) / (x[i] - x[i - 1]);
+                return Math.max(1, Math.min(255, Math.round(y[i - 1] + f * (y[i] - y[i - 1]))));
+            }
+        }
+        return 255;
+    }
