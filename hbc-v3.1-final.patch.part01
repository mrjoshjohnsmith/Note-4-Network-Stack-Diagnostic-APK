+        if (temperaturePath.length() > 0 && readInt(temperaturePath, -1) != 25) writeNode(temperaturePath, "25");
+        if (batterySiopPath.length() > 0 && readInt(batterySiopPath, -1) != 100) writeNode(batterySiopPath, "100");
